      ["nutrition.body_composition.glycogen", "Glycogen", "+= carb intake x 0.8 up to 400 g; -= work (about 60 g per MET-hour over 4 MET); the Endurance pool's glycogenFactor = 0.5 + 0.5 x glycogen/400", "g", "proposed", "open"],
